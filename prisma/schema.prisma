generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserCategory {
  STUDENT
  STAFF
}

enum AttendanceStatus {
  PRESENT
}

model Admin {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Person {
  id           String       @id @default(cuid())
  uniqueId     String       @unique
  username     String?      @unique
  fullName     String
  phone        String
  email        String?
  category     UserCategory
  department   String
  active       Boolean      @default(true)
  registeredAt DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  attendance   Attendance[]
  hostedVisitorVisits VisitorVisit[] @relation("VisitorHost")

  @@index([fullName])
  @@index([category, active])
}

model AttendanceSession {
  id         String       @id @default(cuid())
  tokenHash  String       @unique
  title      String
  active     Boolean      @default(true)
  startsAt   DateTime     @default(now())
  endsAt     DateTime?
  createdAt  DateTime     @default(now())
  attendance Attendance[]
  visitorVisits VisitorVisit[]

  @@index([active, endsAt])
}

model VisitorVisit {
  id                 String            @id @default(cuid())
  visitorName        String
  visitorNameKey     String
  visitDay           String            @db.VarChar(10)
  hostName           String
  hostPersonId       String?
  sessionId          String
  checkedAt          DateTime          @default(now())
  hostPerson         Person?           @relation("VisitorHost", fields: [hostPersonId], references: [id], onDelete: SetNull)
  session            AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@unique([visitorNameKey, visitDay])
  @@index([checkedAt])
  @@index([hostPersonId, checkedAt])
}

model Attendance {
  id        String            @id @default(cuid())
  personId  String
  sessionId String
  status    AttendanceStatus  @default(PRESENT)
  checkedAt DateTime          @default(now())
  person    Person            @relation(fields: [personId], references: [id], onDelete: Restrict)
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@unique([personId, sessionId])
  @@index([checkedAt])
}
